[Unit]
Description=WeChat read-only database monitor and local GUI sender
After=wechat-desktop-bridge.service
Wants=wechat-desktop-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/PATH/TO/ruanruan/desktop
ExecStart=/usr/bin/python3 database_operator.py
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
UMask=0077
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
ExecStopPost=-/usr/bin/docker rm -f ruanruan-wechat-reader ruanruan-wechat-vision

[Install]
WantedBy=default.target
